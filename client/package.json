{
  "name": "mu-web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run copy-worklet-assets",
    "prebuild": "npm run copy-worklet-assets",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "copy-worklet-assets": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/js-synthesizer/externals/libfluidsynth-2.4.6.js','public/libfluidsynth-2.4.6.js');fs.copyFileSync('node_modules/js-synthesizer/dist/js-synthesizer.worklet.js','public/js-synthesizer.worklet.js')\""
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@nextjournal/lang-clojure": "^1.0.0",
    "@replit/codemirror-vim": "^6.2.0",
    "js-synthesizer": "^1.10.0"
  },
  "license": "MIT"
}
