.cpcache/
target/
.nrepl-port

# Built client assets -- web!'s default :root, kept present but empty so
# a fresh clone has a valid directory to serve from.
client/dist/*
!client/dist/.gitkeep
client/node_modules
node_modules/

# Soundfont (licence varies, user-supplied) and js-synthesizer's worklet
# assets (copied from node_modules by the predev/prebuild npm scripts --
# node_modules stays the single source of the version).
client/public/*.sf2
client/public/libfluidsynth-2.4.6.js
client/public/js-synthesizer.worklet.js

# Design specs and implementation plans. Kept locally, deliberately not
# published -- they are working notes, not documentation.
docs/superpowers/
