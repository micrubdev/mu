{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:test
  {:extra-paths ["test" "dev" "web"]
   :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                 io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 http-kit/http-kit      {:mvn/version "2.8.0"}
                 cheshire/cheshire      {:mvn/version "5.13.0"}
                 nrepl/nrepl            {:mvn/version "1.3.0"}}
   ;; ZGC here too: the clock tests run under the real collector.
   :jvm-opts    ["-XX:+UseZGC" "-XX:+ZGenerational"]
   :exec-fn     cognitect.test-runner.api/test
   ;; The runner defaults to #".*-test$", which would silently skip
   ;; mu.pattern-props -- the algebra's law suite, and the thing most
   ;; likely to catch a regression. Match the -props namespaces too.
   :exec-args   {:patterns [".*-test$" ".*-props$"]}}

  ;; Performance REPL. AlwaysPreTouch keeps the heap from growing mid-set.
  :live
  {:extra-paths ["dev"]
   :extra-deps  {nrepl/nrepl {:mvn/version "1.3.0"}}
   :jvm-opts    ["-XX:+UseZGC" "-XX:+ZGenerational" "-XX:+AlwaysPreTouch"]
   :main-opts   ["-m" "nrepl.cmdline" "--interactive"]}

  ;; The web view. Its dependencies live here, not in :deps -- src/ stays
  ;; loadable with nothing but Clojure on the classpath.
  :web
  {:extra-paths ["web" "dev"]
   :extra-deps  {http-kit/http-kit      {:mvn/version "2.8.0"}
                 cheshire/cheshire      {:mvn/version "5.13.0"}
                 nrepl/nrepl            {:mvn/version "1.3.0"}}
   :jvm-opts    ["-XX:+UseZGC" "-XX:+ZGenerational" "-XX:+AlwaysPreTouch"]}}}
